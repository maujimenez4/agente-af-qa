# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.

# --- Jira Cloud (token con scopes: read:jira-work, write:jira-work) ---
JIRA_BASE_URL=https://TU_SITIO.atlassian.net
JIRA_CLOUD_ID=TU_CLOUD_ID
JIRA_EMAIL=TU_EMAIL
JIRA_API_TOKEN=TU_TOKEN_JIRA
JIRA_PROJECT_KEY=TU_CLAVE_PROYECTO
JIRA_TEST_SUBTASK_TYPE=Subtarea
# simulation (por defecto): el agente prepara lo que publicaría sin escribir en Jira. live: publica.
JIRA_PUBLISH_MODE=simulation

# --- Proveedores LLM gratuitos (D-14) ---
GROQ_API_KEY=TU_API_KEY_GROQ
OPENROUTER_API_KEY=TU_API_KEY_OPENROUTER
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_VULKAN=1   # opcional: aceleración con GPU integrada (se configura en el servicio de Ollama)

# --- Base de datos ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=TU_CONTRASEÑA_LOCAL
POSTGRES_DB=agente
DATABASE_URL=postgresql+psycopg://agente:TU_CONTRASEÑA_LOCAL@127.0.0.1:5432/agente

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API para el frontend (T-55) ---
# Orígenes permitidos separados por comas; vacío = solo el mismo origen (proxy de Vite).
API_ALLOWED_ORIGINS=
# Cookie sin Secure: solo en desarrollo y si el navegador no está en localhost.
API_INSECURE_DEV_COOKIE=false
API_SESSION_IDLE_MINUTES=30
API_SESSION_MAX_HOURS=12

# --- Datos personales (RGPD, PA-279) ---
# Días que se conservan las revisiones de calidad guardadas (se purgan al arrancar la API).
QUALITY_RETENTION_DAYS=90

# --- Servidor MCP de solo lectura (T-59) ---
# Usuario del agente con el que actúa `uv run python -m mcp_server` (sin él no arranca) y su rol:
# functional (buscar, ver y revisar la calidad) o qa (buscar y ver). Nada escribe en Jira.
MCP_USER=af-demo
MCP_ROLE=functional
